# Copie para .env.local e preencha com os dados do seu projeto Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Use somente a chave sb_publishable_. Nunca coloque secret/service_role em NEXT_PUBLIC_*.

# Exclusivamente no servidor, para excluir a própria conta após reautenticação.
# Nunca use NEXT_PUBLIC_ nesta variável. Não versione .env.local.
SUPABASE_SERVICE_ROLE_KEY=
